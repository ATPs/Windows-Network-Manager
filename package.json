{
  "name": "windows-network-manager",
  "version": "1.0.0",
  "description": "Windows network interface, metric, route and profile manager",
  "scripts": {
    "start": "set \"PATH=%USERPROFILE%\\.cargo\\bin;%PATH%\"&& frontend\\node_modules\\.bin\\tauri dev",
    "dev": "frontend\\node_modules\\.bin\\vite --config frontend/vite.config.js",
    "build": "frontend\\node_modules\\.bin\\vite build --config frontend/vite.config.js",
    "tauri": "set \"PATH=%USERPROFILE%\\.cargo\\bin;%PATH%\"&& frontend\\node_modules\\.bin\\tauri",
    "test": "set \"PATH=%USERPROFILE%\\.cargo\\bin;%PATH%\"&& cargo test",
    "check": "set \"PATH=%USERPROFILE%\\.cargo\\bin;%PATH%\"&& cargo check",
    "dist": "set \"PATH=%USERPROFILE%\\.cargo\\bin;%PATH%\"&& frontend\\node_modules\\.bin\\tauri build --bundles nsis"
  },
